# =============================================================================
# Strata Systems MX — variables de entorno
# Copia este archivo a `.env.local` y completa con valores reales (nunca commitees .env.local).
# =============================================================================

# ----- Aplicación ------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3001"
NODE_ENV="development"

# ----- Base de datos (Postgres / Neon en producción) ------------------------
# Local: usa docker-compose.yml (postgres:postgres@localhost:5432/rex)
# Producción: Neon connection string desde el panel de Vercel
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rex?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/rex?schema=public"

# ----- Clerk (autenticación) -------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"

# ----- Storage S3-compatible (fotos y PDFs) -----------------------------------
# Producción: Supabase Storage (Storage -> Settings -> S3 Configuration).
#   STORAGE_ENDPOINT="https://<ref>.storage.supabase.co/storage/v1/s3"
#   STORAGE_REGION="<región del proyecto, ej. us-east-1>"
#   STORAGE_PUBLIC_URL="https://<ref>.supabase.co/storage/v1/object/public/<bucket>"
# También sirve Cloudflare R2 (endpoint https://<account>.r2.cloudflarestorage.com,
# región "auto"); las variables R2_* viejas se siguen aceptando como respaldo.
# Sin storage, en dev los archivos se guardan en public/generated-pdfs.
STORAGE_ENDPOINT=""
STORAGE_REGION=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_BUCKET=""
STORAGE_PUBLIC_URL=""

# ----- Resend (correos transaccionales) --------------------------------------
RESEND_API_KEY=""
RESEND_FROM_EMAIL="no-reply@strata.mx"

# ----- WhatsApp Cloud API (Meta) ---------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# ----- Mapbox (mapa de inmuebles) --------------------------------------------

# ----- Google Maps (Embed API en pantallas públicas de promotores) -----------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# ----- Cron / Tareas programadas --------------------------------------------
CRON_SECRET=""
