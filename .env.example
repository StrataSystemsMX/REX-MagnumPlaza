# =============================================================================
# Strata Systems MX — variables de entorno
# Copia este archivo a `.env` y completa con valores reales (nunca commitees .env).
# =============================================================================

# ----- Aplicación ------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ----- Base de datos (Postgres / Neon en producción) ------------------------
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public
DATABASE_URL="postgresql://strata:strata@localhost:5432/strata?schema=public"
# Solo si usas Neon u otro pooler con conexión directa para migraciones
DIRECT_URL=""

# ----- Clerk (autenticación) -------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"
CLERK_WEBHOOK_SECRET=""

# ----- Cloudflare R2 (almacenamiento de archivos) ----------------------------
# Requerido en producción para subir fotos de inmuebles, contratos en PDF, etc.
# En dev se puede dejar vacío: el código guarda los archivos localmente bajo
# `public/generated-pdfs/` para que Next los sirva. R2_PUBLIC_URL debe apuntar
# al dominio público del bucket (ej. https://uploads.strata.mx) — sin él,
# next/image no podrá cargar las imágenes en producción.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="strata-uploads"
R2_PUBLIC_URL=""

# ----- Resend (correos transaccionales) --------------------------------------
RESEND_API_KEY=""
RESEND_FROM_EMAIL="no-reply@strata.mx"

# ----- WhatsApp Cloud API (Meta) ---------------------------------------------
# Si WHATSAPP_ACCESS_TOKEN está vacío, los envíos se simulan en consola y los
# NotificationLog quedan en SENT igualmente (modo desarrollo). Ver README §
# "WhatsApp / Notificaciones".
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
# Token arbitrario que defines tú; debe coincidir con el que registres en
# Meta al suscribirte al webhook.
WHATSAPP_VERIFY_TOKEN=""
# App secret de la Meta App; usado para verificar la firma X-Hub-Signature-256
# de los webhooks entrantes.
WHATSAPP_APP_SECRET=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# ----- Mapbox (mapa de inmuebles) --------------------------------------------
NEXT_PUBLIC_MAPBOX_TOKEN=""

# ----- Cron / Tareas programadas --------------------------------------------
CRON_SECRET=""
