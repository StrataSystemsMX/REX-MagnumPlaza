# =============================================================================
# Strata Systems MX — variables de entorno
# Copia este archivo a `.env.local` y completa con valores reales (nunca commitees .env.local).
# =============================================================================

# ----- Aplicación ------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ----- Base de datos (Postgres / Neon en producción) ------------------------
# Local: usa docker-compose.yml (postgres:postgres@localhost:5432/rex)
# Producción: Neon connection string desde el panel de Vercel
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rex?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/rex?schema=public"

# ----- Clerk (autenticación) -------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"
CLERK_WEBHOOK_SECRET=""

# ----- Cloudflare R2 (almacenamiento de archivos) ----------------------------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="rex-uploads"
R2_PUBLIC_URL=""

# ----- Resend (correos transaccionales) --------------------------------------
RESEND_API_KEY=""
RESEND_FROM_EMAIL="no-reply@strata.mx"

# ----- WhatsApp Cloud API (Meta) ---------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# ----- Mapbox (mapa de inmuebles) --------------------------------------------
NEXT_PUBLIC_MAPBOX_TOKEN=""

# ----- Google Maps (Embed API en pantallas públicas de promotores) -----------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# ----- Cron / Tareas programadas --------------------------------------------
CRON_SECRET=""
