// ============================================================================
// STRATA SYSTEMS MX — Database Schema
// ============================================================================
// Diseñado para multi-tenancy con shared schema (columna tenant_id)
// Basado en el modelo operativo real de CRT/TSR/QHS extraído del Excel
// del cliente y la junta del 27 Abril 2026.
// ============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// MULTI-TENANCY
// ============================================================================
// Cada cliente del SaaS = un Tenant.
// CRT/TSR/QHS son LegalEntities dentro del mismo Tenant (porque pertenecen
// al mismo grupo empresarial y se administran juntas).
// ============================================================================

model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique @db.VarChar(50) // ej. "crt-plazas-magnum"
  name      String   @db.VarChar(120) // "Plazas Magnum"
  plan      Plan     @default(STARTER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Configuración por cliente
  brandPrimaryColor String? @db.VarChar(6) // hex sin #
  brandLogoUrl      String? @db.VarChar(512)
  contactPhone      String? @db.VarChar(20) // teléfono para CTA WhatsApp en links públicos de promotores (E.164 sin "+")
  // Contacto de la oficina (Eli): recibe COPIA de los avisos de cobranza
  // (inquilino + oficina). officeWhatsapp en E.164 sin "+".
  officeEmail       String? @db.VarChar(254)
  officeWhatsapp    String? @db.VarChar(20)
  timezone          String  @default("America/Hermosillo") @db.VarChar(50)
  currency          String  @default("MXN") @db.VarChar(3)

  // Notificaciones automáticas (Prompt 9 — WhatsApp)
  // OVERDUE_3M nunca se envía automáticamente aunque este flag esté en true:
  // requiere intervención humana siempre. Ver lib/services/notifications.ts.
  autoSendOverdueNotifications Boolean @default(false)
  autoSendPaymentConfirmations Boolean @default(false)

  // Relaciones
  users             User[]
  legalEntities     LegalEntity[]
  properties        Property[]
  units             Unit[]
  tenants_lessee    Lessee[]
  contracts         Contract[]
  rents             Rent[]
  payments          Payment[]
  expenses          Expense[]
  expenseCategories ExpenseCategory[]
  payrolls          Payroll[]
  maintenances      Maintenance[]
  promoters         Promoter[]
  promoterLinks     PromoterLink[]
  budgets           Budget[]
  notifications     NotificationLog[]
  documents         Document[]
  guarantees        Guarantee[]
  auditLogs            AuditLog[]
  morositySnapshots    MorosityDailySnapshot[]
  loans                Loan[]
  loanPayments         LoanPayment[]
  investmentProjects   InvestmentProject[]
  investmentPayments   InvestmentPayment[]

  @@map("tenants")
}

enum Plan {
  STARTER // Hasta 30 unidades
  GROWTH // Hasta 100 unidades
  ENTERPRISE // Ilimitado
}

// ============================================================================
// USUARIOS Y PERMISOS
// ============================================================================
// Roles por usuario. Las acciones específicas (borrar contrato, ver finanzas)
// se controlan mediante Permission asociado al rol.
// ============================================================================

model User {
  id        String   @id @default(cuid())
  tenantId  String
  email     String   @db.VarChar(254)
  name      String   @db.VarChar(120)
  phone     String?  @db.VarChar(20)
  clerkId   String?  @unique @db.VarChar(50) // Si usamos Clerk
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roles     UserRole[]
  auditLogs AuditLog[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  code        RoleCode @unique
  name        String   @db.VarChar(80)
  description String?  @db.VarChar(255)

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

enum RoleCode {
  MASTER // Juan Carlos. Ve todo, autoriza decisiones críticas.
  ADMIN // Eli, Leonardo. Operación completa con permisos granulares.
  ACCOUNTANT // Solo lectura financiera, exporta para despacho contable.
  PROMOTER // Externo, ve solo inmuebles asignados.
  LESSEE // Inquilino, ve su estado de cuenta (futuro).
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

model Permission {
  id   String @id @default(cuid())
  code String @unique @db.VarChar(80) // ej. "contract.delete", "finance.view", "tenant.export"
  name String @db.VarChar(120)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ============================================================================
// ENTIDADES LEGALES (las "razones sociales" del cliente)
// ============================================================================
// CRT, TSR, QHS son ejemplos. Cada Tenant puede tener múltiples LegalEntity.
// Es CRÍTICO para la lógica fiscal: una propiedad puede ser de QHS pero
// administrada y facturada por CRT mediante un contrato interno.
// ============================================================================

model LegalEntity {
  id         String   @id @default(cuid())
  tenantId   String
  code       String   @db.VarChar(10) // "CRT", "TSR", "QHS"
  legalName  String   @db.VarChar(200) // razón social completa
  rfc        String?  @db.VarChar(13)
  address    String?  @db.VarChar(255)
  isOperator Boolean  @default(false) // ¿es la que opera/factura?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownedProperties   Property[]         @relation("OwnerEntity")
  managedProperties Property[]         @relation("ManagerEntity")
  expenses          Expense[]
  rents             Rent[]
  budgets           Budget[]
  payrolls          Payroll[]
  paidCadastrals    CadastralPayment[] @relation("CadastralPayer")
  loans             Loan[]
  investmentProjects InvestmentProject[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("legal_entities")
}

// ============================================================================
// PROPIEDADES Y UNIDADES
// ============================================================================
// Property = inmueble completo (ej. "Plaza Magnum Progreso")
// Unit = local individual rentable dentro de la propiedad (ej. "L1 - Goyoma")
//
// Esta separación es importante: en Plaza Progreso hay 9 locales que se
// rentan por separado a diferentes inquilinos.
// ============================================================================

model Property {
  id              String       @id @default(cuid())
  tenantId        String
  ownerEntityId   String // dueña legal (puede ser QHS)
  managerEntityId String // quién factura/administra (puede ser CRT)
  name            String         @db.VarChar(50) // "Plaza Magnum Progreso"
  type            PropertyType
  status          PropertyStatus @default(ACTIVO) // BLOQUEADO = no se renta (ej. casa del dueño)
  address         String         @db.VarChar(120)
  cadastralKey    String?        @db.VarChar(30) // clave catastral
  latitude        Float?
  longitude       Float?
  totalArea       Float? // m²
  notes           String?
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerEntity       LegalEntity        @relation("OwnerEntity", fields: [ownerEntityId], references: [id])
  managerEntity     LegalEntity        @relation("ManagerEntity", fields: [managerEntityId], references: [id])
  units              Unit[]
  cadastralPayments  CadastralPayment[]
  maintenances       Maintenance[]
  documents          Document[]
  investmentProjects InvestmentProject[]
  budgetLines        BudgetLine[]

  @@index([tenantId])
  @@index([ownerEntityId])
  @@index([managerEntityId])
  @@map("properties")
}

enum PropertyType {
  PLAZA_COMERCIAL // Plaza Progreso, Olivares, Quiroga
  TERRENO_RENTADO // Inbursa Blvd Kino
  EDIFICIO // La Chila Garmendia
  OFICINA // Capilla del Carmen, Oficina Elias
  CASA // Para clientes con Airbnb o casas individuales
  BODEGA // Bodega CRT
  ESPECTACULAR // Renta de espacio para anuncio
  OTRO
}

enum PropertyStatus {
  ACTIVO // estado normal: rentable / con contrato
  BLOQUEADO // no se renta (ej. casa del dueño); UI oculta renta/inquilino
}

model Unit {
  id                String            @id @default(cuid())
  tenantId          String
  propertyId        String
  code              String            @db.VarChar(20) // "L1", "L2", "LP" (local principal), "OF", "E" (espectacular)
  name              String?           @db.VarChar(50) // alias amigable opcional
  area              Float? // m²
  estimatedRent     Decimal?          @db.Decimal(12, 2)
  status            UnitStatus        @default(DISPONIBLE)
  features          Json? // baños, recámaras, A/C, etc. (flexible)
  depositMonths     Int? // meses de depósito en garantía
  minContractMonths Int? // plazo forzoso mínimo (meses)
  maintenanceFee    Decimal?          @db.Decimal(12, 2) // cuota mensual extra
  availableFrom     DateTime? // null = disponible inmediato
  includedServices  IncludedService[] @default([])
  parentUnitId      String? // si != null, este local está agrupado bajo otro (mismo Property)
  notes             String?
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property      Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  contracts     Contract[]
  documents     Document[]
  maintenances  Maintenance[]
  promoterLinks PromoterLink[]
  parentUnit    Unit?          @relation("UnitGroup", fields: [parentUnitId], references: [id], onDelete: SetNull)
  childUnits    Unit[]         @relation("UnitGroup")

  @@unique([propertyId, code])
  @@index([tenantId])
  @@index([propertyId])
  @@index([parentUnitId])
  @@map("units")
}

enum UnitStatus {
  DISPONIBLE
  APARTADA // alguien la apartó pero no firma todavía
  RENTADA
  EN_REMODELACION
  NO_DISPONIBLE
}

enum IncludedService {
  AGUA
  LUZ
  GAS
  INTERNET
  MANTENIMIENTO // de áreas comunes
  VIGILANCIA
  ESTACIONAMIENTO
}

// ============================================================================
// INQUILINOS (LESSEES)
// ============================================================================
// Tabla separada de Users porque inquilinos pueden no tener acceso al sistema.
// Datos fiscales y de contacto independientes.
// ============================================================================

model Lessee {
  id               String               @id @default(cuid())
  tenantId         String
  legalName        String               @db.VarChar(100) // ej. "Farmacias Benavides S.A.B de C.V."
  contactName      String?              @db.VarChar(50) // ej. "Juan Pablo Martinez"
  rfc              String?              @db.VarChar(13)
  email            String?              @db.VarChar(254)
  phone            String?              @db.VarChar(15)
  whatsapp         String?              @db.VarChar(15) // canal preferido del cliente
  preferredChannel CommunicationChannel @default(WHATSAPP)
  notes            String?
  isActive         Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contracts Contract[]

  @@index([tenantId])
  @@map("lessees")
}

enum CommunicationChannel {
  WHATSAPP
  EMAIL
  SMS
  PHONE_CALL
  IN_PERSON
}

// ============================================================================
// CONTRATOS
// ============================================================================
// Contrato vincula Unit + Lessee con fechas, monto y estado.
// Genera automáticamente un Rent mensual mientras esté activo.
// ============================================================================

model Contract {
  id       String         @id @default(cuid())
  tenantId String
  unitId   String
  lesseeId String
  type     ContractType
  status   ContractStatus @default(DRAFT)

  startDate         DateTime
  endDate           DateTime
  monthlyAmount     Decimal  @db.Decimal(12, 2)
  guaranteeAmount   Decimal  @db.Decimal(12, 2)
  paymentDay        Int      @default(1) // día del mes en que se cobra
  lateFeePercentage Decimal? @db.Decimal(5, 2) // interés moratorio
  autoRenew         Boolean  @default(false)
  // Política de morosidad (protocolo de 2 meses): el aviso fuerte/desalojo a los
  // 2 meses es el detonante automático. El recordatorio amable previo (1 mes) es
  // OPCIONAL y se activa por contrato con este flag (default off).
  friendlyReminderEnabled Boolean @default(false)

  // Casos especiales que detectamos en el Excel:
  paidInAdvance    Boolean   @default(false) // tipo Bluecell que pagó 6 meses
  advancePaidUntil DateTime?

  signedDate DateTime?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit       Unit        @relation(fields: [unitId], references: [id])
  lessee     Lessee      @relation(fields: [lesseeId], references: [id])
  rents      Rent[]
  guarantees Guarantee[]
  documents  Document[]

  @@index([tenantId])
  @@index([unitId])
  @@index([lesseeId])
  @@index([endDate]) // para alertas de vencimiento
  @@map("contracts")
}

enum ContractType {
  ARRENDAMIENTO
  COMODATO
  ADMINISTRACION_INTERNA // ej. CRT administra propiedad de QHS
  COMPRAVENTA
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED // terminó antes de tiempo
  CANCELLED
  PENDING_RENEWAL
}

// ============================================================================
// RENTAS (cargos mensuales generados desde contratos)
// ============================================================================
// Una Rent es el "cargo del mes" para un contrato específico. Se genera
// automáticamente cada mes y se va saldando con uno o más Payment.
//
// Esto permite manejar pagos parciales (caso Sushi: pagó 10mil de 13mil).
// ============================================================================

model Rent {
  id            String     @id @default(cuid())
  tenantId      String
  contractId    String
  legalEntityId String // quién factura este cargo (CRT/TSR/QHS)
  period        DateTime // primer día del mes que cubre (ej. 2026-04-01)
  amountDue     Decimal    @db.Decimal(12, 2)
  amountPaid    Decimal    @default(0) @db.Decimal(12, 2)
  amountWaived  Decimal    @default(0) @db.Decimal(12, 2) // monto condonado (parcial o total)
  // Interés moratorio acumulado (snapshot). Lo recalcula el cron diario y cada
  // pago vía recalcRentInTx, con calculateLateFee sobre el saldo de principal.
  // Se suma al adeudo total (computeBalance) — política CRT: 5% mensual prorrateado.
  lateFeeAccrued Decimal   @default(0) @db.Decimal(12, 2)
  status        RentStatus @default(PENDING)
  dueDate       DateTime
  notes         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contract    Contract    @relation(fields: [contractId], references: [id])
  legalEntity LegalEntity @relation(fields: [legalEntityId], references: [id])
  payments    Payment[]

  @@unique([contractId, period])
  @@index([tenantId])
  @@index([dueDate])
  @@index([status])
  @@map("rents")
}

enum RentStatus {
  PENDING // aún no vence
  DUE // ya venció, no pagado
  PARTIAL // pago parcial recibido
  PAID // saldado
  OVERDUE_1M // 1 mes vencido (dispara aviso 1)
  OVERDUE_2M // 2 meses vencidos (dispara aviso 2)
  OVERDUE_3M // 3 meses vencidos (dispara aviso 3 - desalojo)
  WAIVED // condonado
}

// ============================================================================
// PAGOS
// ============================================================================
// Un Payment es un movimiento de dinero del inquilino hacia la entidad legal.
// Se asocia a uno o más Rent (un pago puede saldar varios meses).
// ============================================================================

model Payment {
  id          String        @id @default(cuid())
  tenantId    String
  rentId      String
  amount      Decimal       @db.Decimal(12, 2)
  paymentDate DateTime
  method      PaymentMethod
  reference   String?       @db.VarChar(120) // número de transferencia, cheque, etc.
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rent   Rent   @relation(fields: [rentId], references: [id])

  @@index([tenantId])
  @@index([rentId])
  @@index([paymentDate])
  @@map("payments")
}

enum PaymentMethod {
  CASH
  TRANSFER
  CHECK
  DEPOSIT
  CARD
  OTHER
}

// ============================================================================
// DEPÓSITOS EN GARANTÍA
// ============================================================================
// Dinero del inquilino que el dueño guarda. Se devuelve al cierre del contrato
// menos deducciones por daños. Requiere evidencia fotográfica al inicio y fin.
// ============================================================================

model Guarantee {
  id             String          @id @default(cuid())
  tenantId       String
  contractId     String
  amount         Decimal         @db.Decimal(12, 2)
  status         GuaranteeStatus @default(HELD)
  receivedDate   DateTime
  returnedDate   DateTime?
  returnedAmount Decimal?        @db.Decimal(12, 2)
  deductions     Json? // [{concept, amount, evidenceDocId}]
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contract Contract @relation(fields: [contractId], references: [id])

  @@index([tenantId])
  @@map("guarantees")
}

enum GuaranteeStatus {
  HELD // en custodia
  PARTIALLY_RETURNED
  RETURNED // devuelto
}

// ============================================================================
// EGRESOS / GASTOS
// ============================================================================
// Reemplaza la sección de egresos del Excel: nómina, prediales, mantenimiento,
// servicios (CFE, agua, telmex), seguros, financiamientos, comisiones, etc.
// ============================================================================

model ExpenseCategory {
  id          String      @id @default(cuid())
  tenantId    String
  code        String      @db.VarChar(60) // "PREDIAL", "NOMINA_DIRECCION", "CFE", etc.
  name        String      @db.VarChar(120)
  type        ExpenseType
  isRecurring Boolean     @default(false)
  parentId    String? // permite jerarquía (Servicios > CFE)

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent      ExpenseCategory?  @relation("ExpenseCategoryHierarchy", fields: [parentId], references: [id])
  children    ExpenseCategory[] @relation("ExpenseCategoryHierarchy")
  expenses    Expense[]
  budgetLines BudgetLine[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("expense_categories")
}

enum ExpenseType {
  PAYROLL // Nóminas
  TAX // SAT, IMSS, Predial, ISRTP
  UTILITY // CFE, Agua, Telmex, Telcel
  MAINTENANCE // Mantenimiento de plazas
  INSURANCE // Seguros
  FINANCING // Financiamiento Toyota, Expedition
  PROFESSIONAL_FEE // Honorarios, despacho contable
  BANK_FEE // Comisiones bancarias
  OFFICE // Papelería, consumo oficina
  VEHICLE // Servicios autos, gasolina
  OTHER
}

model Expense {
  id            String         @id @default(cuid())
  tenantId      String
  legalEntityId String // qué entidad lo paga (CRT/TSR/QHS)
  categoryId    String
  propertyId    String? // si aplica a una propiedad específica
  amount        Decimal        @db.Decimal(12, 2)
  expenseDate   DateTime
  description   String         @db.VarChar(200)
  vendor        String?        @db.VarChar(120)
  invoiceNumber String?        @db.VarChar(80) // folio fiscal / referencia
  paymentMethod PaymentMethod?
  isPaid        Boolean        @default(true)
  // "Sin egreso": el usuario decide manualmente que en este mes no aplica
  // pagar este concepto. Mutuamente exclusivo con isPaid.
  isNotRequired Boolean        @default(false) @map("is_not_required")
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  legalEntity LegalEntity     @relation(fields: [legalEntityId], references: [id])
  category    ExpenseCategory @relation(fields: [categoryId], references: [id])
  documents   Document[]

  @@index([tenantId])
  @@index([legalEntityId])
  @@index([expenseDate])
  @@map("expenses")
}

// ============================================================================
// PREDIALES (caso especial: pagos catastrales por propiedad)
// ============================================================================
// Separado de Expense porque tiene reglas únicas:
// - Asociado a clave catastral
// - Puede pagarse en hasta 4 parcialidades
// - Tiene descuentos por pronto pago en Q1
// ============================================================================

model CadastralPayment {
  id                   String    @id @default(cuid())
  tenantId             String
  propertyId           String
  year                 Int
  // Opcional porque el cliente a veces aún no conoce el monto al darlo de
  // alta (ej. prediales de terceros que llegan con boleta posterior).
  totalAmount          Decimal?  @db.Decimal(12, 2)
  paidAmount           Decimal?  @db.Decimal(12, 2)
  paymentDate          DateTime?
  dueDate              DateTime
  isPaid               Boolean   @default(false)
  // LegalEntity del tenant que efectivamente paga, si difiere del dueño.
  // Ej: "CAP CARMEN" la paga TSR aunque sea de otra razón social.
  payerEntityId        String?
  // Tercero externo al tenant que paga (no es LegalEntity).
  // Ej: "JC" paga prediales de inmuebles administrados por CRT. Solo aplica cuando no es payerEntityId.
  paidByThirdPartyName String?   @db.VarChar(80)
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  property    Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  payerEntity LegalEntity? @relation("CadastralPayer", fields: [payerEntityId], references: [id])
  documents   Document[]

  @@unique([propertyId, year])
  @@index([tenantId])
  @@map("cadastral_payments")
}

// ============================================================================
// NÓMINA (resumen mensual por entidad legal)
// ============================================================================
// El cliente la lleva separada en el Excel. Tiene tanto nómina propia
// como factura de servicios administrativos (Audazon, OSC).
// ============================================================================

model Payroll {
  id               String      @id @default(cuid())
  tenantId         String
  legalEntityId    String
  period           DateTime // primer día del mes
  type             PayrollType
  amount           Decimal     @db.Decimal(12, 2)
  amountWithoutTax Decimal?    @db.Decimal(12, 2)
  taxAmount        Decimal?    @db.Decimal(12, 2)
  description      String?     @db.VarChar(120)
  notes            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  legalEntity LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([period])
  @@map("payrolls")
}

enum PayrollType {
  ADMIN_SERVICE_INVOICE // Factura de servicios administrativos (Audazon, OSC)
  DIRECT_PAYROLL // Nómina directa
  STRATEGY_NOMINA // Estrategia fiscal
  COMMISSION // Comisiones
  BONUS
}

// ============================================================================
// MANTENIMIENTOS
// ============================================================================
// Periódicos (techos antes de lluvias) y variables (incidencias).
// Pueden estar a cargo del dueño o del inquilino según contrato.
// ============================================================================

model Maintenance {
  id                String                    @id @default(cuid())
  tenantId          String
  propertyId        String
  unitId            String? // null = aplica a la propiedad completa
  type              MaintenanceType
  status            MaintenanceStatus         @default(PLANNED)
  responsibility    MaintenanceResponsibility @default(OWNER)
  title             String                    @db.VarChar(80)
  description       String?
  scheduledDate     DateTime?
  completedDate     DateTime?
  cost              Decimal?                  @db.Decimal(12, 2)
  vendor            String?                   @db.VarChar(100)
  isRecurring       Boolean                   @default(false)
  recurrencePattern String?                   @db.VarChar(100) // cron-like, ej. "yearly:may" para techos pre-lluvia
  notes             String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property  Property   @relation(fields: [propertyId], references: [id])
  unit      Unit?      @relation(fields: [unitId], references: [id])
  documents Document[]

  @@index([tenantId])
  @@index([scheduledDate])
  @@map("maintenances")
}

enum MaintenanceType {
  PERIODIC // techos antes de lluvia, fumigación
  CORRECTIVE // arreglar A/C que falló
  PREVENTIVE // pintura, limpieza
  EMERGENCY // fuga, daño urgente
  REMODELING // remodelación mayor
}

enum MaintenanceStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  OVERDUE
}

enum MaintenanceResponsibility {
  OWNER // lo paga la entidad dueña
  LESSEE // lo paga el inquilino
  SHARED // se prorratea
}

// ============================================================================
// PROMOTORES EXTERNOS
// ============================================================================
// Vendedores externos (NEX, individuales) que ayudan a rentar locales
// desocupados. Sin acceso al sistema, pero tienen un link público temporal.
// ============================================================================

model Promoter {
  id        String   @id @default(cuid())
  tenantId  String
  fullName  String   @db.VarChar(50)
  phone     String   @db.VarChar(15)
  email     String?  @db.VarChar(100)
  agency    String?  @db.VarChar(60) // "NEX", "Independiente", etc.
  rating    Int? // 1-5, basado en éxito histórico
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  links  PromoterLink[]

  @@index([tenantId])
  @@map("promoters")
}

model PromoterLink {
  id             String   @id @default(cuid())
  tenantId       String
  promoterId     String
  unitId         String
  publicToken    String   @unique @db.VarChar(100) // token único para URL pública
  expiresAt      DateTime
  isActive       Boolean  @default(true)
  visitCount     Int      @default(0)
  resultedInRent Boolean  @default(false)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  promoter Promoter @relation(fields: [promoterId], references: [id])
  unit     Unit     @relation(fields: [unitId], references: [id])

  @@index([tenantId])
  @@index([publicToken])
  @@index([expiresAt])
  @@map("promoter_links")
}

// ============================================================================
// PRESUPUESTO ANUAL
// ============================================================================
// Replica funcionalidad de las hojas Cierre/Presupuesto del Excel.
// Permite comparar presupuestado vs ejecutado mes a mes.
// ============================================================================

model Budget {
  id            String   @id @default(cuid())
  tenantId      String
  legalEntityId String
  year          Int
  notes         String?
  isLocked      Boolean  @default(false) // si ya se cerró el ejercicio
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  legalEntity LegalEntity  @relation(fields: [legalEntityId], references: [id])
  lines       BudgetLine[]

  @@unique([tenantId, legalEntityId, year])
  @@index([tenantId])
  @@map("budgets")
}

model BudgetLine {
  id           String            @id @default(cuid())
  budgetId     String
  categoryId   String? // si es egreso
  propertyId   String? // si es ingreso atado a un inmueble específico
  conceptType  BudgetConceptType
  conceptLabel String            @db.VarChar(120) // "PLAZA PROGRESO", "Predial CRT", etc.
  // 12 columnas para los 12 meses del año
  jan          Decimal           @default(0) @db.Decimal(12, 2)
  feb          Decimal           @default(0) @db.Decimal(12, 2)
  mar          Decimal           @default(0) @db.Decimal(12, 2)
  apr          Decimal           @default(0) @db.Decimal(12, 2)
  may          Decimal           @default(0) @db.Decimal(12, 2)
  jun          Decimal           @default(0) @db.Decimal(12, 2)
  jul          Decimal           @default(0) @db.Decimal(12, 2)
  aug          Decimal           @default(0) @db.Decimal(12, 2)
  sep          Decimal           @default(0) @db.Decimal(12, 2)
  oct          Decimal           @default(0) @db.Decimal(12, 2)
  nov          Decimal           @default(0) @db.Decimal(12, 2)
  dec          Decimal           @default(0) @db.Decimal(12, 2)

  budget   Budget           @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category ExpenseCategory? @relation(fields: [categoryId], references: [id])
  property Property?        @relation(fields: [propertyId], references: [id])

  @@index([budgetId])
  @@index([propertyId])
  @@map("budget_lines")
}

enum BudgetConceptType {
  INCOME_RENT // ingresos por renta
  INCOME_BILLBOARD // espectacular
  INCOME_GUARANTEE // depósitos en garantía recibidos
  INCOME_OTHER
  EXPENSE // egresos operativos (categoryId obligatorio)
  TAX_STRATEGY // sueldos adicionales / estrategia fiscal (debajo de utilidad operativa)
  DEBT_SERVICE // hipotecas y préstamos (debajo de utilidad operativa)
}

// ============================================================================
// DOCUMENTOS Y ARCHIVOS
// ============================================================================
// Genérico, polimorfico. Puede asociarse a contrato, propiedad, gasto,
// mantenimiento, depósito en garantía, etc.
// ============================================================================

model Document {
  id           String       @id @default(cuid())
  tenantId     String
  type         DocumentType
  filename     String       @db.VarChar(255)
  url          String       @db.VarChar(512) // R2/S3 URL
  mimeType     String?      @db.VarChar(100)
  sizeBytes    Int?
  uploadedById String?
  notes        String?
  sortOrder    Int? // posición manual (asc = primero). null = sin asignar, ordena por createdAt.
  createdAt    DateTime     @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Relaciones polimórficas (solo una será no-null)
  contractId         String?
  contract           Contract?         @relation(fields: [contractId], references: [id])
  propertyId         String?
  property           Property?         @relation(fields: [propertyId], references: [id])
  unitId             String?
  unit               Unit?             @relation(fields: [unitId], references: [id])
  expenseId          String?
  expense            Expense?          @relation(fields: [expenseId], references: [id])
  maintenanceId      String?
  maintenance        Maintenance?      @relation(fields: [maintenanceId], references: [id])
  cadastralPaymentId String?
  cadastralPayment   CadastralPayment? @relation(fields: [cadastralPaymentId], references: [id])

  @@index([tenantId])
  @@map("documents")
}

enum DocumentType {
  CONTRACT_PDF
  PROPERTY_PHOTO
  UNIT_PHOTO // foto general/showcase de la unidad
  UNIT_PHOTO_INITIAL // foto al entrar el inquilino
  UNIT_PHOTO_FINAL // foto al salir el inquilino
  INVOICE
  CADASTRAL_RECEIPT // boleta predial
  EVICTION_LETTER // carta de desalojo generada
  PAYMENT_REMINDER // aviso de pago generado
  MAINTENANCE_PHOTO
  IDENTIFICATION
  PROOF_OF_ADDRESS
  OTHER
}

// ============================================================================
// COMUNICACIÓN Y NOTIFICACIONES
// ============================================================================
// Bitácora de cada comunicación enviada al inquilino. Resuelve dolor del
// cliente: "ya no sabemos qué le mandamos a quién".
// ============================================================================

model NotificationLog {
  id            String                    @id @default(cuid())
  tenantId      String
  recipientType NotificationRecipientType
  recipientId   String                    @db.VarChar(50) // lesseeId, promoterId, userId, etc.
  channel       CommunicationChannel
  templateCode  String?                   @db.VarChar(80) // "RENT_REMINDER_1M", "EVICTION_NOTICE"
  subject       String?                   @db.VarChar(255)
  body          String                    @db.Text
  status        NotificationStatus        @default(PENDING)
  sentAt        DateTime?
  deliveredAt   DateTime?
  failureReason String?                   @db.VarChar(500)
  externalId    String?                   @db.VarChar(100) // ID de WhatsApp/email provider
  createdAt     DateTime                  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([recipientType, recipientId])
  @@index([sentAt])
  @@map("notification_logs")
}

enum NotificationRecipientType {
  LESSEE
  PROMOTER
  USER
  EXTERNAL
  OFFICE // copia interna a la oficina (Eli)
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
  BOUNCED
}

// ============================================================================
// AUDITORÍA
// ============================================================================
// Registro de quién hizo qué, especialmente para acciones críticas
// (borrar contratos, modificar pagos). El cliente lo pidió explícitamente.
// ============================================================================

model AuditLog {
  id         String      @id @default(cuid())
  tenantId   String
  userId     String?
  action     AuditAction
  entityType String      @db.VarChar(50) // "Contract", "Payment", etc.
  entityId   String      @db.VarChar(50)
  changes    Json? // diff de antes/después
  ipAddress  String?     @db.VarChar(45)
  userAgent  String?
  createdAt  DateTime    @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  LOGIN
  LOGOUT
  EXPORT
  PERMISSION_CHANGE
}

// ============================================================================
// INVERSIONES Y PRÉSTAMOS
// ============================================================================
// Préstamos: vehículos (Toyota, Expedition, BMW) y otros créditos que CRT/TSR
// pagan mensualmente. Cada préstamo tiene un schedule mensual (LoanPayment).
//
// Proyectos de inversión: obras de construcción/remodelación con presupuesto
// vs ejecutado. Ej: "Etapa Final Plaza Quiroga" ($152k/sem).
// ============================================================================

model Loan {
  id             String     @id @default(cuid())
  tenantId       String
  legalEntityId  String
  name           String     @db.VarChar(120) // "Crédito Toyota Hilux", "Crédito Ford Expedition"
  lender         String?    @db.VarChar(120) // banco/institución financiera
  type           LoanType
  originalAmount Decimal    @db.Decimal(12, 2)
  currentBalance Decimal    @db.Decimal(12, 2)
  monthlyPayment Decimal    @db.Decimal(12, 2)
  interestRate   Decimal?   @db.Decimal(6, 4) // tasa anual decimal (ej. 0.1200 = 12%)
  startDate      DateTime
  endDate        DateTime? // fecha estimada de liquidación
  paymentDay     Int? // día del mes en que vence el pago
  status         LoanStatus @default(ACTIVE)
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  legalEntity LegalEntity   @relation(fields: [legalEntityId], references: [id])
  payments    LoanPayment[]

  @@index([tenantId])
  @@index([legalEntityId])
  @@map("loans")
}

enum LoanType {
  VEHICLE // Toyota, Expedition, BMW
  MORTGAGE
  PERSONAL
  CORPORATE
  LINE_OF_CREDIT
  OTHER
}

enum LoanStatus {
  ACTIVE
  PAID_OFF
  REFINANCED
  DEFAULTED
  CANCELLED
}

model LoanPayment {
  id          String    @id @default(cuid())
  tenantId    String
  loanId      String
  period      DateTime // primer día del mes (ej. 2026-05-01)
  amount      Decimal   @db.Decimal(12, 2)
  principal   Decimal?  @db.Decimal(12, 2)
  interest    Decimal?  @db.Decimal(12, 2)
  paymentDate DateTime?
  isPaid      Boolean   @default(false)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  loan   Loan   @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@unique([loanId, period])
  @@index([tenantId])
  @@index([period])
  @@map("loan_payments")
}

model InvestmentProject {
  id             String                  @id @default(cuid())
  tenantId       String
  legalEntityId  String
  propertyId     String? // obra asociada a una propiedad específica
  name           String                  @db.VarChar(120) // "Etapa Final Plaza Quiroga"
  description    String?
  budgetAmount   Decimal                 @db.Decimal(12, 2)
  executedAmount Decimal                 @default(0) @db.Decimal(12, 2)
  startDate      DateTime
  endDate        DateTime?
  status         InvestmentProjectStatus @default(ACTIVE)
  notes          String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  legalEntity LegalEntity         @relation(fields: [legalEntityId], references: [id])
  property    Property?           @relation(fields: [propertyId], references: [id])
  payments    InvestmentPayment[]

  @@index([tenantId])
  @@map("investment_projects")
}

enum InvestmentProjectStatus {
  PLANNING
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

model InvestmentPayment {
  id          String   @id @default(cuid())
  tenantId    String
  projectId   String
  description String   @db.VarChar(255)
  amount      Decimal  @db.Decimal(12, 2)
  paymentDate DateTime
  isPaid      Boolean  @default(false)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant  Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project InvestmentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([projectId])
  @@index([paymentDate])
  @@map("investment_payments")
}

// ============================================================================
// MOROSIDAD — snapshot diario
// ============================================================================
// Foto fija (1 fila por tenant por día) del estado de la cartera de Rents.
// Permite hacer gráficas históricas tipo "cómo evolucionó la morosidad
// este mes". La escribe el cron de update-rent-statuses al final de cada
// corrida (upsert por [tenantId, date]).
// ============================================================================

model MorosityDailySnapshot {
  id            String   @id @default(cuid())
  tenantId      String
  date          DateTime @db.Date
  byStatus      Json // { PENDING: n, DUE: n, PARTIAL: n, OVERDUE_1M: n, ... }
  totalAmount   Decimal  @db.Decimal(14, 2) // suma de amountDue de TODOS los rents del día
  overdueAmount Decimal  @db.Decimal(14, 2) // saldo pendiente (amountDue - amountPaid) en estados DUE/PARTIAL/OVERDUE_*
  createdAt     DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date])
  @@index([tenantId])
  @@map("morosity_daily_snapshots")
}
