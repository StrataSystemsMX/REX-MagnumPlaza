# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# local docker port overrides (cada dev tiene su propio puerto)
docker-compose.override.yml

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/playwright/.cache

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# database dumps (backups de prod — contienen datos reales del cliente, NUNCA commitear)
*.dump

# env files (NEVER commit secrets — use .env.example as template)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated client
/src/generated

# clerk configuration (can include secrets)
/.clerk/

# PDFs generados localmente cuando R2 no está configurado
/public/generated-pdfs/
.claude/settings.local.json
