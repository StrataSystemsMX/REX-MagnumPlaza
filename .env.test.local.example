# =============================================================================
# REX — variables locales para E2E
# Copia este archivo a `.env.test.local`.
# Usa SIEMPRE Clerk de desarrollo y una base local/staging desechable.
# =============================================================================

DATABASE_URL="postgresql://postgres:rex@localhost:5432/postgres"
DIRECT_URL="postgresql://postgres:rex@localhost:5432/postgres"

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

E2E_CLERK_USER_EMAIL="e2e@rex.test"
E2E_CLERK_USER_PASSWORD=""

# Opcional. Por default Playwright usa http://127.0.0.1:3000.
PLAYWRIGHT_BASE_URL="http://127.0.0.1:3000"
